{
  "identifier": "center-page",
  "description": "Seven Station Core 页面可以调用壳的命令",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*", "http://*:*/*", "https://*:*/*"]
  },
  "permissions": [
    "core:default",
    "allow-pick-folder",
    "allow-reveal-path",
    "allow-reveal-in-explorer",
    "allow-copy-file",
    "allow-open-url",
    "allow-center-local",
    "allow-client-config-get",
    "allow-client-config-save"
  ]
}
