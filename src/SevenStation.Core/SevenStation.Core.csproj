<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SevenStation.Core</AssemblyName>
    <RootNamespace>SevenStation.Core</RootNamespace>
    <Version>0.5.2</Version>
    <!-- 发布出来的是 GUI 子系统：执行代理由计划任务在登录时拉起，控制台子系统会弹一个 cmd 窗口，
         用户一关窗口代理就被 CTRL_CLOSE 杀掉（任务结果 0xC000013A）。服务与 runner 角色都不需要控制台，
         日志一律写文件；用 dotnet 跑 dll 时输出照旧（那是 dotnet 宿主自己的控制台）。 -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Log.cs" Link="Log.cs" />
    <Compile Include="..\Shared\ProductPaths.cs" Link="ProductPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 装成 Windows 服务跑：没有它就只能当控制台程序。 -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.4" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- 10.0.4 默认带 2.1.11 的 e_sqlite3，有已知漏洞，钉到修好的原生库。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 从 bin 目录直接启动时 content root 就是 exe 所在目录，页面要跟着复制过去。 -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Agents\pi-guidance.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- 每轮注入界面纪律 + 改写相对路径的 Pi 扩展，由 Core 用 -e 加载。 -->
    <Content Include="Agents\sevenstation-guard.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
