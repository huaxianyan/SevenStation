<?xml version="1.0" encoding="utf-8"?>
<!--
  SevenStation 客户端的安装程序（MSI）。

  装给整台机器：客户端以后还要承担「节点」角色，节点是后台服务，机器级装法才立得住。
  装的时候不问 Seven Station Core 地址和令牌：装完第一次打开会走引导页填一次，之后在
  「设置 → 这台设备连的 Seven Station Core」里随时改，填错不用重装。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Seven Station"
      Manufacturer="SevenStation"
      Version="$(var.Version)"
      UpgradeCode="dbac07cf-54b7-479c-a7ae-8029388412a7"
      Scope="perMachine"
      Compressed="yes"
      Codepage="936"
      Language="2052"
      InstallerVersion="500">

    <SummaryInformation Description="SevenStation 客户端：连上 Seven Station Core 看任务、下指令。" />

    <!--
      升级前先关掉开着的客户端，否则 exe 被占用会跳过替换。
      走 taskkill 而不是发关闭消息：WebView2 的浏览器进程会占着缓存目录，/T 一起收干净。
    -->
    <Property Id="KillRunningOnInstall"
              Value="&quot;[System64Folder]taskkill.exe&quot; /F /T /IM SevenStation.exe" />
    <Property Id="KillRunningOnRemove"
              Value="&quot;[System64Folder]taskkill.exe&quot; /F /T /IM SevenStation.exe" />
    <CustomAction Id="KillRunningOnInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="KillRunningOnRemove" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="KillRunningOnInstall" Before="InstallFiles" Condition="1" />
      <Custom Action="KillRunningOnRemove" Before="RemoveFiles" Condition='REMOVE~="ALL"' />
    </InstallExecuteSequence>

    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="已经装了更新的版本，请先卸载再装旧版。" Schedule="afterInstallValidate" />
    <MediaTemplate EmbedCab="yes" />

    <!-- 客户端是 WebView2 壳，没有运行时窗口起不来。 -->
    <Property Id="WEBVIEW2MACHINE">
      <!-- 整机安装的运行时写在 32 位视图里，所以要 always32 读，路径里不带 WOW6432Node。 -->
      <RegistrySearch Id="WebView2MachineSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="WEBVIEW2USER">
      <RegistrySearch Id="WebView2UserSearch" Root="HKCU"
                      Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv" Type="raw" />
    </Property>
    <Launch Condition="WEBVIEW2MACHINE OR WEBVIEW2USER" Message="这台机器没有 WebView2 运行时，客户端打不开。先装上 WebView2（微软官网的 Evergreen Runtime），再运行本安装程序。" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SevenStation" />
    </StandardDirectory>

    <Component Id="ClientExecutable" Directory="INSTALLFOLDER" Guid="*">
      <File Id="ClientExe" Source="$(var.BuildDir)\SevenStation.exe" KeyPath="yes" />
    </Component>

    <Component Id="Shortcuts" Directory="ProgramMenuFolder" Guid="a7d5e2b8-3f14-4c96-8bd2-51c7f0a9e263">
      <!-- 通知要能弹出来，快捷方式上必须带这个 ID：Windows 只认「有应用身份的 toast」，
           光在注册表登记 AppUserModelId 不够（试过，系统直接把通知丢掉）。 -->
      <Shortcut Id="MenuShortcut" Name="Seven Station" Target="[#ClientExe]" WorkingDirectory="INSTALLFOLDER">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="com.neko7ina.sevenstation.windows" />
      </Shortcut>
      <Shortcut Id="DesktopShortcut" Name="SevenStation" Directory="DesktopFolder" Target="[#ClientExe]" WorkingDirectory="INSTALLFOLDER">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="com.neko7ina.sevenstation.windows" />
      </Shortcut>
      <RemoveFolder Id="RemoveMenuShortcut" On="uninstall" />
    </Component>

    <Feature Id="Main" Title="SevenStation 客户端" Level="1" AllowAbsent="no">
      <ComponentRef Id="ClientExecutable" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <!-- WixUI 的欢迎页自带一段 lorem ipsum 假许可，必须换成真的，否则装的时候满屏假文字。 -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)\dialog.bmp" />

    <!-- 向导走 WixUI 默认的三页（欢迎/许可 → 进度 → 完成）。Seven Station Core 地址与令牌不在这里问：
         客户端设置页里有「这台设备连的 Seven Station Core」那一块，装完随时能填能改，装的时候填错还得重装。 -->
    <ui:WixUI Id="WixUI_Minimal" />

  </Package>
</Wix>
