<?xml version="1.0" encoding="utf-8"?>
<!--
  Seven Station Core 的安装程序（MSI）。

  Seven Station Core 是机器级的东西：装到 Program Files，注册成 Windows 服务，开机自己起来。
  不用便携版——双击 exe 一跑了之的形态没法保证服务、开机启动和升级。
  数据不放在安装目录：%ProgramData%\SevenStation.Core\（配置、令牌、对话库、日志），
  卸载时留在原处，重装或升级接得上。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Seven Station Core"
      Manufacturer="SevenStation"
      Version="$(var.Version)"
      UpgradeCode="c262dd6d-8dae-4ad8-8e7e-4f05f8761264"
      Scope="perMachine"
      Codepage="936"
      Language="2052"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="Seven Station Core：为客户端提供对话与 Agent 服务。" />

    <!--
      装之前把还在跑的都结束掉：文件被占用时 Windows Installer 会跳过替换，装完等于没装。
      服务由下面的 ServiceControl 停；托盘里的 Control 点关闭只会缩回托盘、不会退出，
      便携方式跑的 Core 也没人管，所以统一用 taskkill 收掉。
      /T 连 Pi 子进程一起带走，别留一个孤儿 node 占着会话。
    -->
    <Property Id="KillRunningOnInstall"
              Value="&quot;[System64Folder]taskkill.exe&quot; /F /T /IM SevenStation.Control.exe /IM SevenStation.Core.exe" />
    <Property Id="KillRunningOnRemove"
              Value="&quot;[System64Folder]taskkill.exe&quot; /F /T /IM SevenStation.Control.exe /IM SevenStation.Core.exe" />
    <CustomAction Id="KillRunningOnInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="KillRunningOnRemove" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />

    <!-- 卸载时把执行代理的登录任务一起带走：任务留着也只会指向一个不存在的 exe。
         任务名要和 Seven Station Control 建的那个一致。 -->
    <Property Id="RemoveRunnerTask"
              Value="&quot;[System64Folder]schtasks.exe&quot; /delete /tn &quot;SevenStation Core Runner&quot; /f" />
    <CustomAction Id="RemoveRunnerTask" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="KillRunningOnInstall" Before="InstallFiles" Condition="1" />
      <Custom Action="RemoveRunnerTask" Before="RemoveFiles" Condition='REMOVE~="ALL"' />
      <Custom Action="KillRunningOnRemove" Before="RemoveFiles" Condition='REMOVE~="ALL"' />
    </InstallExecuteSequence>

    <!-- 「应用和功能」里那一项的图标 -->
    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- 升级时先停服务再换文件；旧版本自动卸掉。 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="已经装了更新的版本，请先卸载再装旧版。" Schedule="afterInstallValidate" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SevenStation Core" />
    </StandardDirectory>

    <!-- 主程序本体。服务要指向它，所以单独一个组件、KeyPath 就是 exe。 -->
    <Component Id="CoreExecutable" Directory="INSTALLFOLDER" Guid="*">
      <File Id="CoreExe" Source="$(var.PublishDir)\SevenStation.Core.exe" KeyPath="yes" />

      <ServiceInstall
          Id="CoreService"
          Name="SevenStationCore"
          DisplayName="Seven Station Core"
          Description="Seven Station Core：管对话库与 Agent 子进程，客户端连它。"
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem"
          Vital="yes" />

      <!-- 装完直接起；升级和卸载时先停；卸载时把服务摘掉。 -->
      <ServiceControl Id="CoreServiceControl" Name="SevenStationCore"
                      Start="install" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <!-- 运行时与前端。逐个列太脆，按目录收。 -->
    <ComponentGroup Id="CorePayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\*.dll" />
      <Files Include="$(var.PublishDir)\*.json" />
      <Files Include="$(var.PublishDir)\wwwroot\**" Subdirectory="wwwroot" />
    </ComponentGroup>

    <!-- Seven Station Control：跟 Seven Station Core 装在一起，用来开停服务、看日志、改监听地址（DECISIONS D9）。 -->
    <Component Id="ControlExecutable" Directory="INSTALLFOLDER" Guid="*">
      <!-- 装到安装目录时按产品名命名，别留 cargo 的 sevenstation-control.exe -->
      <File Id="ControlExe" Source="$(var.ControlExe)" Name="SevenStation.Control.exe" KeyPath="yes" />
    </Component>

    <!-- 开始菜单：打开 Seven Station Core 页面（带令牌）、打开配置、Seven Station Control。 -->
    <Component Id="StartMenuShortcuts" Directory="ProgramMenuFolder" Guid="892982fe-e529-4982-82cb-454e868408ea">
      <File Id="OpenCenterCmd" Source="payload\open-page.cmd" />
      <File Id="OpenSettingsCmd" Source="payload\open-settings.cmd" />
      <Shortcut Id="ShortcutOpenCenter" Name="Seven Station Core 页面" Target="[#OpenCenterCmd]" WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="ShortcutOpenSettings" Name="Seven Station Core 配置" Target="[#OpenSettingsCmd]" WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="ShortcutControl" Name="Seven Station Control" Target="[#ControlExe]" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveShortcuts" On="uninstall" />
    </Component>

    <!-- 双击 MSI 要有个向导：说明、进度、完成。没有 UI 时 Windows Installer 一个窗都不留。 -->
    <!-- 许可页：WixUI 自带的是一段假文字，换成仓库里的 GPL 说明。 -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <!-- 向导画面：顶栏和对话框底图都是自己生成的（design/make-installer-art.py） -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)\dialog.bmp" />

    <ui:WixUI Id="WixUI_Minimal" />

    <!-- 完成页勾上就叫 Seven Station Control 起来：装完就能拿到地址和令牌去配别的设备。 -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="打开 Seven Station Control" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchControl" FileRef="ControlExe" ExeCommand="" Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchControl" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <Feature Id="Main" Title="Seven Station Core" Level="1" AllowAbsent="no">
      <ComponentRef Id="CoreExecutable" />
      <ComponentRef Id="ControlExecutable" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentGroupRef Id="CorePayload" />
    </Feature>

    <!-- 数据目录不归安装程序管：卸载后留着，重装接得上。 -->
  </Package>
</Wix>
